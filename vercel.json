{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/book",
      "destination": "/book.html"
    },
    {
      "source": "/book/",
      "destination": "/book.html"
    },
    {
      "source": "/quote",
      "destination": "/quote.html"
    },
    {
      "source": "/quote/",
      "destination": "/quote.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/areas-we-serve",
      "headers": [
        {
          "key": "Cache-Control",
